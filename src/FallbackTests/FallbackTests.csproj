<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyLab.ApiClient\MyLab.ApiClient.csproj" />
  </ItemGroup>

  <!-- Reference only the V3Contracts assembly; host provides MyLab.ApiClient 4.x for type unification -->
  <Target Name="BuildAndReferenceV3Contracts" BeforeTargets="ResolveAssemblyReferences">
    <MSBuild Projects="..\V3Contracts\V3Contracts.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <Reference Include="V3Contracts">
        <HintPath>..\V3Contracts\bin\$(Configuration)\net10.0\V3Contracts.dll</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>

</Project>
